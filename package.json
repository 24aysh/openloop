{
  "name": "openloop",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "db:migrate": "bun apps/backend/scripts/migrate.ts",
    "check-types": "tsc --noEmit -p apps/backend/tsconfig.json",
    "lint": "oxlint apps/backend/src apps/backend/scripts apps/backend/tests --deny-warnings",
    "test:mind": "bun test apps/backend/tests/mind"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "oxlint": "1.88.0",
    "typescript": "5.9.3"
  }
}
