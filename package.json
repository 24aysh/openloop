{
  "name": "openloop",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "db:migrate": "bun apps/backend/scripts/migrate.ts",
    "check-types": "tsc --noEmit -p apps/backend/tsconfig.json && tsc --noEmit -p apps/frontend/tsconfig.json",
    "lint": "oxlint apps/backend/src apps/backend/scripts apps/backend/tests apps/frontend/src apps/frontend/tests --deny-warnings",
    "test:mind": "bun test apps/backend/tests/mind",
    "test:transcripts": "bun test apps/backend/tests/transcripts",
    "test:sessions": "bun test apps/backend/tests/sessions",
    "test:voice": "bun test apps/frontend/tests/voice",
    "test:frontend": "bun test apps/frontend/tests",
    "test:reconciliation": "bun test apps/backend/tests/reconciliation",
    "test:scheduling": "bun test apps/backend/tests/scheduling",
    "test:integration": "bun test apps/backend/tests/integration"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/ws": "8.18.1",
    "oxlint": "1.88.0",
    "typescript": "5.9.3"
  }
}
